{
  "name": "codex-staff",
  "version": "0.1.0",
  "description": "Delegate research, reviews, implementation and general tasks to Codex CLI.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pStrikeZ/codex-staff.git"
  },
  "homepage": "https://github.com/pStrikeZ/codex-staff",
  "bugs": {
    "url": "https://github.com/pStrikeZ/codex-staff/issues"
  },
  "keywords": [
    "pi-package",
    "opencode-plugin",
    "codex",
    "delegation"
  ],
  "engines": {
    "node": ">=20",
    "opencode": ">=1.18.34 <2"
  },
  "bin": {
    "codex-staff": "companion/codex-companion.mjs"
  },
  "files": [
    ".codex-plugin/",
    ".claude-plugin/",
    ".agents/plugins/",
    "skills/",
    "pi-skills/",
    "opencode-skills/",
    "opencode.mjs",
    "companion/",
    "templates/",
    "scripts/generate-skills.mjs",
    "docs/",
    "README.zh-CN.md",
    "NOTICE"
  ],
  "scripts": {
    "generate:pi": "node scripts/generate-skills.mjs --target=pi",
    "check:pi": "node scripts/generate-skills.mjs --target=pi --check",
    "generate:opencode": "node scripts/generate-skills.mjs --target=opencode",
    "check:opencode": "node scripts/generate-skills.mjs --target=opencode --check",
    "generate:skills": "node scripts/generate-skills.mjs",
    "check:skills": "node scripts/generate-skills.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "test:real": "node --test tests/real-codex.integration.mjs",
    "test:opencode": "node --test tests/opencode.integration.mjs",
    "pack:checked": "npm run check:skills && npm pack --ignore-scripts",
    "prepublishOnly": "npm run check:skills"
  },
  "main": "./opencode.mjs",
  "exports": "./opencode.mjs",
  "pi": {
    "skills": [
      "./pi-skills"
    ]
  }
}
